{
  "name": "coderev",
  "version": "0.1.0",
  "description": "Open-source CLI that reviews public GitHub repos with Nvidia NIM (free) or BYOK OpenAI-compatible providers. No database.",
  "type": "module",
  "bin": {
    "coderev": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "code-review",
    "github",
    "nvidia-nim",
    "openai",
    "byok",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "ai": "^4.3.16",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
