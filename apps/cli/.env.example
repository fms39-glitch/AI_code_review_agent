# --- Free path: Nvidia NIM (OpenAI-compatible) ---
# Get a key: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=nvapi-your-key-here
# Optional overrides:
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- BYOK: OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- BYOK: any OpenAI-compatible endpoint (Groq, Ollama, gateways, etc.) ---
# API_KEY=your-key
# BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini

# --- Optional: higher GitHub API rate limits for public repos ---
# GITHUB_TOKEN=ghp_...
